<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#0a0a12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="description" content="Samous 游戏工坊 - 385款免费在线H5游戏，无需下载即点即玩">
<link rel="manifest" href="manifest.json">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎮</text></svg>">
<title>Samous 的游戏工坊</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#0a0a12;
  --card:rgba(255,255,255,.04);
  --card-hover:rgba(200,150,255,.08);
  --border:rgba(255,255,255,.08);
  --border-hover:rgba(200,150,255,.3);
  --text:#fff;
  --text-dim:#888;
  --accent:#c49bff;
  --accent2:#ff6b35;
  --gold:#ffd700;
}
html,body{
  height:100%;
  background:var(--bg);
  color:var(--text);
  font-family:"Microsoft YaHei","PingFang SC",sans-serif;
  overflow:hidden;
}
.app{
  display:flex;
  flex-direction:column;
  height:100vh;
  max-width:100vw;
}
.header{
  padding:12px 16px;
  background:rgba(10,10,18,.95);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--border);
  position:sticky;
  top:0;
  z-index:100;
}
.header-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin-bottom:12px;
}
.logo{
  display:flex;
  align-items:center;
  gap:8px;
}
.logo-icon{font-size:28px}
.logo-text{
  font-size:18px;
  font-weight:900;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
}
.header-actions{
  display:flex;
  gap:8px;
}
.btn{
  padding:6px 12px;
  border-radius:20px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--text-dim);
  font-size:12px;
  cursor:pointer;
  transition:.2s;
}
.btn:hover{
  border-color:var(--border-hover);
  color:var(--text);
  background:var(--card-hover);
}
.btn-primary{
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  border:none;
  color:#fff;
  font-weight:bold;
}
.btn-primary:hover{
  opacity:.9;
  transform:scale(1.02);
}
.search-box{position:relative}
.search-input{
  width:100%;
  padding:10px 16px 10px 36px;
  border-radius:24px;
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  font-size:14px;
  outline:none;
  transition:.2s;
}
.search-input:focus{
  border-color:var(--accent);
  box-shadow:0 0 0 2px rgba(196,155,255,.2);
}
.search-input::placeholder{color:var(--text-dim)}
.search-icon{
  position:absolute;
  left:12px;
  top:50%;
  transform:translateY(-50%);
  font-size:16px;
  opacity:.5;
}
.stats-bar{
  display:flex;
  gap:12px;
  padding:8px 16px;
  background:rgba(255,255,255,.02);
  border-bottom:1px solid var(--border);
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
}
.stat-chip{
  display:flex;
  align-items:center;
  gap:4px;
  padding:4px 10px;
  border-radius:12px;
  background:var(--card);
  font-size:11px;
  white-space:nowrap;
}
.stat-chip .num{
  font-weight:bold;
  color:var(--gold);
}
.category-tabs{
  display:flex;
  gap:6px;
  padding:10px 16px;
  overflow-x:auto;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
}
.category-tabs::-webkit-scrollbar{display:none}
.tab{
  padding:6px 14px;
  border-radius:16px;
  border:1px solid var(--border);
  background:transparent;
  color:var(--text-dim);
  font-size:12px;
  cursor:pointer;
  white-space:nowrap;
  transition:.2s;
}
.tab:hover{
  border-color:var(--border-hover);
  color:var(--text);
}
.tab.active{
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  border:none;
  color:#fff;
  font-weight:bold;
}
.game-area{
  flex:1;
  overflow-y:auto;
  padding:12px 16px;
  -webkit-overflow-scrolling:touch;
}
.game-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(100px,1fr));
  gap:10px;
}
.game-card{
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:14px 8px;
  background:var(--card);
  border:1px solid var(--border);
  border-radius:14px;
  cursor:pointer;
  transition:.2s;
  text-decoration:none;
  color:var(--text);
}
.game-card:hover{
  border-color:var(--border-hover);
  background:var(--card-hover);
  transform:translateY(-2px);
  box-shadow:0 6px 20px rgba(150,100,255,.15);
}
.game-card:active{transform:scale(.95)}
.game-icon{
  font-size:36px;
  margin-bottom:6px;
  line-height:1;
}
.game-name{
  font-size:11px;
  font-weight:600;
  text-align:center;
  line-height:1.3;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
  overflow:hidden;
}
.game-tag{
  font-size:9px;
  color:var(--text-dim);
  margin-top:4px;
  padding:2px 6px;
  background:rgba(255,255,255,.05);
  border-radius:6px;
}
.bottom-bar{
  display:flex;
  justify-content:space-around;
  padding:8px 0;
  background:rgba(10,10,18,.98);
  border-top:1px solid var(--border);
  padding-bottom:max(8px,env(safe-area-inset-bottom));
}
.bottom-btn{
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:2px;
  padding:4px 12px;
  background:none;
  border:none;
  color:var(--text-dim);
  font-size:10px;
  cursor:pointer;
  transition:.2s;
}
.bottom-btn .icon{font-size:20px}
.bottom-btn.active{color:var(--accent)}
.empty-state{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:60px 20px;
  text-align:center;
}
.empty-state .icon{
  font-size:64px;
  margin-bottom:16px;
  opacity:.5;
}
.empty-state .text{
  color:var(--text-dim);
  font-size:14px;
}
.install-banner{
  display:none;
  padding:12px 16px;
  background:linear-gradient(135deg,rgba(196,155,255,.15),rgba(255,107,53,.15));
  border-bottom:1px solid var(--border);
  align-items:center;
  gap:12px;
}
.install-banner.show{display:flex}
.install-text{
  flex:1;
  font-size:13px;
}
.install-close{
  background:none;
  border:none;
  color:var(--text-dim);
  font-size:18px;
  cursor:pointer;
}
.preview-overlay{
  display:none;
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.8);
  z-index:1000;
  align-items:center;
  justify-content:center;
  padding:20px;
}
.preview-overlay.show{display:flex}
.preview-box{
  width:100%;
  max-width:420px;
  background:var(--bg);
  border-radius:20px;
  border:1px solid var(--border);
  overflow:hidden;
}
.preview-header{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:16px;
  border-bottom:1px solid var(--border);
}
.preview-title{
  font-size:16px;
  font-weight:bold;
}
.preview-close{
  background:none;
  border:none;
  color:var(--text-dim);
  font-size:24px;
  cursor:pointer;
}
.preview-content{
  padding:20px;
  text-align:center;
}
.preview-icon{
  font-size:72px;
  margin-bottom:16px;
}
.preview-desc{
  color:var(--text-dim);
  font-size:13px;
  margin-bottom:20px;
  line-height:1.6;
  white-space:pre-line;
}
.preview-actions{
  display:flex;
  gap:10px;
  justify-content:center;
}
.preview-actions .btn{
  padding:10px 24px;
  font-size:14px;
}
@media(min-width:768px){
  .game-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}
}
@media(min-width:1024px){
  .app{
    max-width:480px;
    margin:0 auto;
    border-left:1px solid var(--border);
    border-right:1px solid var(--border);
  }
}
</style>
<style>
.ad-banner-container{position:fixed;bottom:0;left:0;right:0;z-index:5;display:flex;justify-content:center;align-items:center;background:rgba(0,0,0,.45);backdrop-filter:blur(4px);height:90px;max-height:90px;overflow:hidden;contain:layout style paint;pointer-events:none!important}.ad-banner-container,.ad-banner-container *{pointer-events:none!important}.ad-banner-container iframe{max-height:90px;pointer-events:none!important}
.ad-banner-container iframe{max-width:100%}
.ad-label{position:absolute;top:1px;right:6px;font:9px "Microsoft YaHei",sans-serif;color:rgba(255,255,255,.35)}
.sponsor-btn{position:fixed;top:44px;right:8px;z-index:20;background:rgba(255,215,0,.12);border:1px solid rgba(255,215,0,.25);color:#ffd700;padding:3px 9px;border-radius:10px;font:11px "Microsoft YaHei",sans-serif;cursor:pointer;transition:.2s}
.sponsor-btn:hover{background:rgba(255,215,0,.25);transform:scale(1.05)}
.sponsor-panel{position:fixed;inset:0;background:rgba(0,0,0,.94);z-index:200;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;pointer-events:none}
.sponsor-panel h2{color:#ffd700;font:bold 26px "Microsoft YaHei",sans-serif;margin-bottom:4px}
.sponsor-panel .qr-row{display:flex;gap:24px;flex-wrap:wrap;justify-content:center}
.sponsor-panel .qr-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:16px;padding:16px;text-align:center;min-width:140px}
.sponsor-panel .qr-card .qr-icon{font-size:48px;margin-bottom:6px}
.sponsor-panel .qr-card .qr-label{color:#ccc;font:13px "Microsoft YaHei",sans-serif}
.sponsor-panel .qr-card .qr-hint{color:#888;font:11px "Microsoft YaHei",sans-serif;margin-top:4px}
.sponsor-panel .sponsor-close{margin-top:8px;padding:8px 28px;border:1px solid rgba(255,255,255,.2);border-radius:20px;color:#aaa;background:0 0;font:14px "Microsoft YaHei",sans-serif;cursor:pointer;transition:.2s}
.sponsor-panel .sponsor-close:hover{background:rgba(255,255,255,.08);color:#fff}
.interstitial-ad{position:fixed;inset:0;background:rgba(0,0,0,.92);z-index:999;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;pointer-events:none}
.interstitial-ad .ad-content{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:16px;padding:20px;text-align:center;min-width:280px;max-width:400px}
.interstitial-ad .ad-content p{color:#aaa;font:14px "Microsoft YaHei",sans-serif;margin-bottom:12px}
.interstitial-ad .skip-btn{padding:8px 28px;background:rgba(255,215,0,.15);border:1px solid rgba(255,215,0,.3);border-radius:20px;color:#ffd700;font:bold 15px "Microsoft YaHei",sans-serif;cursor:pointer;transition:.2s}
.interstitial-ad .skip-btn:hover{background:rgba(255,215,0,.25)}
</style>
</head>
<body>
<div class="app">
  <div class="install-banner" id="installBanner">
    <span class="icon">📲</span>
    <span class="install-text">安装游戏工坊到桌面，随时畅玩！</span>
    <button class="btn btn-primary" onclick="installApp()">安装</button>
    <button class="install-close" onclick="dismissInstall()">×</button>
  </div>

  <header class="header">
    <div class="header-top">
      <div class="logo">
        <span class="logo-icon">🎮</span>
        <span class="logo-text">游戏工坊</span>
      </div>
      <div class="header-actions">
        <button class="btn" onclick="showRandom()">🎲 随机</button>
        <button class="btn" onclick="showAbout()">关于</button>
      </div>
    </div>
    <div class="search-box">
      <span class="search-icon">🔍</span>
      <input class="search-input" id="searchInput" type="text" placeholder="搜索游戏..." oninput="filterGames()">
    </div>
  </header>

  <div class="stats-bar">
    <div class="stat-chip">🎮 <span class="num" id="totalCount">0</span> 款游戏</div>
    <div class="stat-chip">📂 <span class="num" id="catCount">0</span> 个分类</div>
    <div class="stat-chip">⭐ <span class="num">100%</span> 免费</div>
    <div class="stat-chip">📱 <span class="num">H5</span> 即点即玩</div>
  </div>

  <div class="category-tabs" id="categoryTabs"></div>

  <div class="game-area" id="gameArea">
    <div class="game-grid" id="gameGrid"></div>
  </div>

  <div class="bottom-bar">
    <button class="bottom-btn active" onclick="showAll()">
      <span class="icon">🏠</span>
      <span>全部</span>
    </button>
    <button class="bottom-btn" onclick="showRecent()">
      <span class="icon">⏱️</span>
      <span>最近</span>
    </button>
    <button class="bottom-btn" onclick="showFav()">
      <span class="icon">⭐</span>
      <span>收藏</span>
    </button>
    <button class="bottom-btn" onclick="showSettings()">
      <span class="icon">⚙️</span>
      <span>设置</span>
    </button>
  </div>
</div>

<div class="preview-overlay" id="previewOverlay" onclick="closePreview(event)">
  <div class="preview-box" onclick="event.stopPropagation()">
    <div class="preview-header">
      <span class="preview-title" id="previewTitle"></span>
      <button class="preview-close" onclick="closePreview()">×</button>
    </div>
    <div class="preview-content">
      <div class="preview-icon" id="previewIcon"></div>
      <div class="preview-desc" id="previewDesc"></div>
      <div class="preview-actions">
        <button class="btn" onclick="closePreview()">关闭</button>
        <button class="btn btn-primary" id="previewPlay" onclick="playGame()">▶ 开始游戏</button>
      </div>
    </div>
  </div>
</div>

<script>
const GAMES = [
  {id:"2048变体",name:"2048变体",icon:"🧩",cat:"经典益智",file:"2048变体.html"},
  {id:"2048大师",name:"2048大师",icon:"🧩",cat:"经典益智",file:"2048大师.html"},
  {id:"2048滑动",name:"2048滑动 · 六边形棋盘",icon:"🧩",cat:"经典益智",file:"2048滑动.html"},
  {id:"2048数字",name:"2048数字游戏",icon:"🧩",cat:"经典益智",file:"2048数字.html"},
  {id:"21点",name:"21点 · 赌场风云",icon:"🎮",cat:"休闲模拟",file:"21点.html"},
  {id:"暗影割草",name:"暗影割草 - Shadow Mower",icon:"⚔️",cat:"动作冒险",file:"暗影割草.html"},
  {id:"摆锤游戏",name:"摆锤游戏",icon:"⚔️",cat:"动作冒险",file:"摆锤游戏.html"},
  {id:"宝藏猎人",name:"宝藏猎人",icon:"⚔️",cat:"动作冒险",file:"宝藏猎人.html"},
  {id:"宝石迷阵",name:"宝石迷阵",icon:"💎",cat:"消除休闲",file:"宝石迷阵.html"},
  {id:"保龄球",name:"保龄球",icon:"🎮",cat:"休闲模拟",file:"保龄球.html"},
  {id:"编中国结",name:"编中国结",icon:"📜",cat:"古诗文化",file:"编中国结.html"},
  {id:"捕鱼达人",name:"捕鱼达人",icon:"⚔️",cat:"动作冒险",file:"捕鱼达人.html"},
  {id:"猜灯谜",name:"猜灯谜",icon:"📜",cat:"古诗文化",file:"猜灯谜.html"},
  {id:"餐厅经营",name:"餐厅经营",icon:"🏰",cat:"策略经营",file:"餐厅经营.html"},
  {id:"苍穹射击",name:"苍穹射击",icon:"🎯",cat:"射击弹幕",file:"苍穹射击.html"},
  {id:"超级玛丽",name:"超级玛丽·像素冒险",icon:"⚔️",cat:"动作冒险",file:"超级玛丽.html"},
  {id:"成语闯关",name:"成语闯关",icon:"📝",cat:"文字成语",file:"成语闯关.html"},
  {id:"成语接龙",name:"成语接龙",icon:"📝",cat:"文字成语",file:"成语接龙.html"},
  {id:"成语消消看",name:"成语消消看",icon:"📝",cat:"文字成语",file:"成语消消看.html"},
  {id:"成语消消乐",name:"成语消消乐",icon:"📝",cat:"文字成语",file:"成语消消乐.html"},
  {id:"城堡防御",name:"城堡防御",icon:"🏰",cat:"策略经营",file:"城堡防御.html"},
  {id:"城堡守卫",name:"城堡守卫",icon:"🏰",cat:"策略经营",file:"城堡守卫.html"},
  {id:"城市建设",name:"城市建设",icon:"🏰",cat:"策略经营",file:"城市建设.html"},
  {id:"城市建造",name:"城市建造",icon:"🏰",cat:"策略经营",file:"城市建造.html"},
  {id:"吃豆人",name:"吃豆人大作战",icon:"⚔️",cat:"动作冒险",file:"吃豆人.html"},
  {id:"宠物融合",name:"宠物融合 - 游戏工坊",icon:"🏰",cat:"策略经营",file:"宠物融合.html"},
  {id:"宠物养成",name:"宠物养成",icon:"🎮",cat:"休闲模拟",file:"宠物养成.html"},
  {id:"宠物装扮",name:"宠物装扮",icon:"🎮",cat:"休闲模拟",file:"宠物装扮.html"},
  {id:"抽奖",name:"抽奖",icon:"🎮",cat:"休闲模拟",file:"抽奖.html"},
  {id:"触摸绘画",name:"触摸绘画",icon:"🎮",cat:"休闲模拟",file:"触摸绘画.html"},
  {id:"传奇英雄",name:"传奇英雄",icon:"🎮",cat:"休闲模拟",file:"传奇英雄.html"},
  {id:"词语填空",name:"词语填空",icon:"📝",cat:"文字成语",file:"词语填空.html"},
  {id:"磁力对抗",name:"磁力对抗",icon:"🎮",cat:"休闲模拟",file:"磁力对抗.html"},
  {id:"丛林冒险",name:"丛林冒险",icon:"⚔️",cat:"动作冒险",file:"丛林冒险.html"},
  {id:"蹴鞠",name:"蹴鞠 - 古代足球射门挑战",icon:"⚔️",cat:"动作冒险",file:"蹴鞠.html"},
  {id:"打地鼠",name:"打地鼠",icon:"💎",cat:"消除休闲",file:"打地鼠.html"},
  {id:"打气球",name:"打气球",icon:"💎",cat:"消除休闲",file:"打气球.html"},
  {id:"打砖块",name:"打砖块",icon:"💎",cat:"消除休闲",file:"打砖块.html"},
  {id:"打砖块进阶",name:"打砖块进阶",icon:"💎",cat:"消除休闲",file:"打砖块进阶.html"},
  {id:"打字练习",name:"打字练习",icon:"🎮",cat:"休闲模拟",file:"打字练习.html"},
  {id:"弹弓射击",name:"弹弓射击",icon:"🎯",cat:"射击弹幕",file:"弹弓射击.html"},
  {id:"弹球",name:"弹球",icon:"💎",cat:"消除休闲",file:"弹球.html"},
  {id:"弹球大作战",name:"弹球大作战",icon:"💎",cat:"消除休闲",file:"弹球大作战.html"},
  {id:"弹球反弹",name:"弹球反弹",icon:"💎",cat:"消除休闲",file:"弹球反弹.html"},
  {id:"弹球守门",name:"弹球守门",icon:"💎",cat:"消除休闲",file:"弹球守门.html"},
  {id:"弹跳球",name:"弹跳球",icon:"💎",cat:"消除休闲",file:"弹跳球.html"},
  {id:"弹珠反弹",name:"弹珠反弹",icon:"💎",cat:"消除休闲",file:"弹珠反弹.html"},
