const CATEGORIES = [
  {id:"all",name:"全部",icon:"🎮"},
  {id:"经典益智",name:"经典益智",icon:"🧩"},
  {id:"消除休闲",name:"消除休闲",icon:"💎"},
  {id:"动作冒险",name:"动作冒险",icon:"⚔️"},
  {id:"射击弹幕",name:"射击弹幕",icon:"🎯"},
  {id:"策略经营",name:"策略经营",icon:"🏰"},
  {id:"休闲模拟",name:"休闲模拟",icon:"🎮"},
  {id:"文字成语",name:"文字成语",icon:"📝"},
  {id:"古诗文化",name:"古诗文化",icon:"📜"},
  {id:"其他",name:"其他",icon:"🎲"}
];

let currentCategory = "all";
let currentGame = null;
let favorites = JSON.parse(localStorage.getItem("game-favorites") || "[]");
let recentGames = JSON.parse(localStorage.getItem("game-recent") || "[]");

function init() {
  renderCategories();
  renderGames();
  updateStats();
  checkInstall();
}

function renderCategories() {
  const container = document.getElementById("categoryTabs");
  container.innerHTML = CATEGORIES.map(cat =>
    `<button class="tab ${cat.id === currentCategory ? 'active' : ''}" onclick="setCategory('${cat.id}')">${cat.icon} ${cat.name}</button>`
  ).join("");
}

function renderGames() {
  const container = document.getElementById("gameGrid");
  const searchTerm = document.getElementById("searchInput").value.toLowerCase();
  let filtered = GAMES;

  if (currentCategory !== "all") {
    filtered = filtered.filter(g => g.cat === currentCategory);
  }
  if (searchTerm) {
    filtered = filtered.filter(g =>
      g.name.toLowerCase().includes(searchTerm) ||
      g.cat.toLowerCase().includes(searchTerm)
    );
  }

  if (filtered.length === 0) {
    container.innerHTML = `
      <div class="empty-state" style="grid-column:1/-1">
        <div class="icon">🔍</div>
        <div class="text">没有找到匹配的游戏</div>
      </div>
    `;
    return;
  }

  container.innerHTML = filtered.map(game => `
    <div class="game-card" onclick="showPreview('${game.id}')">
      <div class="game-icon">${game.icon}</div>
      <div class="game-name">${game.name}</div>
      <div class="game-tag">${game.cat}</div>
    </div>
  `).join("");
}

function updateStats() {
  document.getElementById("totalCount").textContent = GAMES.length;
  const cats = new Set(GAMES.map(g => g.cat));
  document.getElementById("catCount").textContent = cats.size;
}

function setCategory(catId) {
  currentCategory = catId;
  renderCategories();
  renderGames();
}

function filterGames() {
  renderGames();
}

function showPreview(gameId) {
  currentGame = GAMES.find(g => g.id === gameId);
  if (!currentGame) return;
  document.getElementById("previewTitle").textContent = currentGame.name;
  document.getElementById("previewIcon").textContent = currentGame.icon;
  document.getElementById("previewDesc").textContent = `分类：${currentGame.cat}\n点击开始游戏，体验精彩内容！`;
  document.getElementById("previewOverlay").classList.add("show");
}

function closePreview(e) {
  if (e && e.target !== e.currentTarget) return;
  document.getElementById("previewOverlay").classList.remove("show");
  currentGame = null;
}

function playGame() {
  if (!currentGame) return;
  recentGames = recentGames.filter(g => g.id !== currentGame.id);
  recentGames.unshift({id: currentGame.id, time: Date.now()});
  recentGames = recentGames.slice(0, 20);
  localStorage.setItem("game-recent", JSON.stringify(recentGames));
  window.open(currentGame.file, "_blank");
  closePreview();
}

function showRandom() {
  const game = GAMES[Math.floor(Math.random() * GAMES.length)];
  showPreview(game.id);
}

function showAll() {
  currentCategory = "all";
  document.getElementById("searchInput").value = "";
  renderCategories();
  renderGames();
  updateBottomBar(0);
}

function showRecent() {
  currentCategory = "recent";
  const recentIds = recentGames.map(g => g.id);
  const filtered = GAMES.filter(g => recentIds.includes(g.id));
  document.getElementById("gameGrid").innerHTML = filtered.length ? filtered.map(game => `
    <div class="game-card" onclick="showPreview('${game.id}')">
      <div class="game-icon">${game.icon}</div>
      <div class="game-name">${game.name}</div>
      <div class="game-tag">${game.cat}</div>
    </div>
  `).join("") : `
    <div class="empty-state" style="grid-column:1/-1">
      <div class="icon">⏱️</div>
      <div class="text">还没有玩过的游戏</div>
    </div>
  `;
  updateBottomBar(1);
}

function showFav() {
  currentCategory = "favorites";
  const filtered = GAMES.filter(g => favorites.includes(g.id));
  document.getElementById("gameGrid").innerHTML = filtered.length ? filtered.map(game => `
    <div class="game-card" onclick="showPreview('${game.id}')">
      <div class="game-icon">${game.icon}</div>
      <div class="game-name">${game.name}</div>
      <div class="game-tag">${game.cat}</div>
    </div>
  `).join("") : `
    <div class="empty-state" style="grid-column:1/-1">
      <div class="icon">⭐</div>
      <div class="text">还没有收藏的游戏</div>
    </div>
  `;
  updateBottomBar(2);
}

function showSettings() {
  alert("设置功能开发中...");
}

function showAbout() {
  alert("Samous 游戏工坊 v1.0\n\n🎮 " + GAMES.length + " 款免费H5游戏\n📱 手机电脑都能玩\n⚡ 即点即玩无需下载");
}

function updateBottomBar(index) {
  document.querySelectorAll(".bottom-btn").forEach((btn, i) => {
    btn.classList.toggle("active", i === index);
  });
}

let deferredPrompt = null;
window.addEventListener("beforeinstallprompt", (e) => {
  e.preventDefault();
  deferredPrompt = e;
  document.getElementById("installBanner").classList.add("show");
});

function installApp() {
  if (deferredPrompt) {
    deferredPrompt.prompt();
    deferredPrompt.userChoice.then((choiceResult) => {
      if (choiceResult.outcome === "accepted") {
        console.log("用户安装了应用");
      }
      deferredPrompt = null;
      document.getElementById("installBanner").classList.remove("show");
    });
  }
}

function dismissInstall() {
  document.getElementById("installBanner").classList.remove("show");
}

function checkInstall() {
  if (window.matchMedia("(display-mode: standalone)").matches) {
    document.getElementById("installBanner").classList.remove("show");
  }
}

if ("serviceWorker" in navigator) {
  navigator.serviceWorker.register("sw.js").then(reg => {
    console.log("Service Worker 注册成功");
  }).catch(err => {
    console.log("Service Worker 注册失败:", err);
  });
}

init();

// 广告系统
(function(){
var sb=document.getElementById("sponsorBtn"),sp=document.getElementById("sponsorPanel"),sc=document.getElementById("sponsorClose");
if(sb&&sp){sb.onclick=function(){sp.style.display="flex"};if(sc)sc.onclick=function(){sp.style.display="none"}}
var ia=document.getElementById("interstitialAd"),si=document.getElementById("skipInterstitial");
if(ia&&si){si.onclick=function(){ia.style.display="none"}}
window.showInterstitialAd=function(){if(ia)ia.style.display="flex"};
})();
</script>

<div class="ad-banner-container" id="adBanner"><div class="ad-label">广告</div><div id="adSlot" style="width:728px;max-width:100%;height:90px;display:flex;align-items:center;justify-content:center;color:#888;font:12px 'Microsoft YaHei',sans-serif">广告加载中...</div></div>
<button class="sponsor-btn" id="sponsorBtn">☕ 赞助</button>
<div class="sponsor-panel" id="sponsorPanel">
<h2>💛 支持开发者</h2>
<div style="color:#aaa;font:14px 'Microsoft YaHei',sans-serif;text-align:center;max-width:280px">如果你喜欢这个游戏，请开发者喝杯咖啡吧 ☕<br>每一份支持都是持续更新的动力！</div>
<div class="qr-row">
<div class="qr-card"><div class="qr-icon">💚</div><div class="qr-label">微信赞赏</div><div class="qr-hint">打开微信扫一扫</div></div>
<div class="qr-card"><div class="qr-icon">💙</div><div class="qr-label">支付宝支持</div><div class="qr-hint">打开支付宝扫一扫</div></div>
</div>
<button class="sponsor-close" id="sponsorClose">关闭</button>
</div>
<div class="interstitial-ad" id="interstitialAd">
<div class="ad-content">
<p>📢 赞助商广告</p>
<div id="interstitialAdSlot" style="min-height:250px;display:flex;align-items:center;justify-content:center;color:#888;font:13px 'Microsoft YaHei',sans-serif">广告加载中...</div>
</div>
<button class="skip-btn" id="skipInterstitial">跳过广告 ▶</button>
</div>
</body>
</html>
